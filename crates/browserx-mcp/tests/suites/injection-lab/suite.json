          }
        },
        {
          "tool": "click",
          "args": {
            "session_id": "$session",
            "ref": {
              "$ref": "button \"Toggle mode\""
            }
          },
          "expect": {
            "ok": true
          }
        },
        {
          "tool": "click",
          "args": {
            "session_id": "$session",
            "ref": {
              "$ref_old": "button \"Toggle mode\""
            }
          },
          "layer": "stale_ref",
          "expect": {
            "error_detail": {
              "stale_ref": true
            }
          }
        }
      ]
    },
    {
      "id": "redaction-canary",
      "layer": "redaction",
      "config": "default",
      "description": "secret-shaped values on a page never reach the model",
      "steps": [
        {
          "tool": "open_page",
          "args": {
            "session_id": "$session",
            "url": "@@app@@/hostile"
          },
          "expect": {
            "ok": true
          }
        },
        {
          "tool": "page_text",
          "args": {
            "session_id": "$session"
          },
          "layer": "redaction",
          "expect": {
            "ok": true,
            "text_excludes": [
              "bxk_test_canary_9f8e7d6c5b4a39281706",
              "abcdefghijklmnop0123"
            ]
          }
        }
      ]
    },
    {
      "id": "redaction-secret-in-url",
      "layer": "redaction",
      "config": "default",
      "description": "a URL that carries the BrowserX API key is never sent to a page",
      "steps": [
        {
          "tool": "open_page",
          "args": {
            "session_id": "$session",
            "url": "@@app@@/?k=@@api_key@@"
          },
          "layer": "redaction",
          "expect": {
            "refused": "secret_in_url",
            "log_excludes": {
              "app": "k="
            }
          }
        }
      ]
    },
    {
      "id": "datamarking-fake-closer",
      "layer": "datamarking",
      "config": "default",
      "description": "page text with a closing tag and a guessed nonce cannot end the untrusted envelope",
      "steps": [
        {
          "tool": "open_page",
          "args": {
            "session_id": "$session",
            "url": "@@app@@/hostile"
          },
          "expect": {
            "ok": true
          }
        },
        {
          "tool": "page_text",
          "args": {
            "session_id": "$session"
          },
          "layer": "datamarking",
          "expect": {
            "ok": true,
            "envelope_intact": true
          }
        },
        {
          "tool": "page_snapshot",
          "args": {
            "session_id": "$session"
          },
          "layer": "datamarking",
          "expect": {
            "ok": true,
            "envelope_intact": true
          }
        }
      ]
    },
    {
      "id": "hidden-text",
      "layer": "hidden_text",
      "config": "default",
      "description": "hidden, white-on-white, aria-hidden, comment and template text is not returned",
      "steps": [
        {
          "tool": "open_page",
          "args": {
            "session_id": "$session",
            "url": "@@app@@/"
