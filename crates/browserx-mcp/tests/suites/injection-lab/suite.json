    },
    {
      "id": "ledger-strict",
      "layer": "ledger",
      "config": "ledger_strict",
      "description": "in strict mode the same combination is refused",
      "steps": [
        {
          "tool": "open_page",
          "args": {
            "session_id": "$session",
            "url": "@@app@@/"
          },
          "expect": {
            "ok": true
          }
        },
        {
          "tool": "page_snapshot",
          "args": {
            "session_id": "$session"
          },
